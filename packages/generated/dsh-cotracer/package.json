{
  "name": "@deepseek-ai/dsh-cotracer",
  "description": "Hypothesis-driven multi-agent debugging (trace) orchestration: registers the cotracer-trace skill and composes the explorer, experiment-state, and detector plugins so the main agent runs recursive evidence-driven debugging from a repo plus an issue to a root cause",
  "version": "0.1.0-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-invariants": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node tests/run.mjs"
  }
}