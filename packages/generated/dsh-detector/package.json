{
  "name": "@deepseek-ai/dsh-detector",
  "description": "Detector investigation subagent for hypothesis-driven multi-agent debugging: a preset role that answers one experiment question inside its scope, writes evidence and conclusions back to the shared experiment tree, and recursively splits and delegates sub-experiments when the question is too large to answer directly",
  "version": "0.1.0-rc.5",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-experiment-state": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-subagent": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/dsh-invariants": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node tests/run.mjs"
  }
}