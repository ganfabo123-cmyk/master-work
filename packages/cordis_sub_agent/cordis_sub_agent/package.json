{
  "name": "dsh-cordis-sub-agent",
  "description": "A DeepSeek Harness plugin for requirement-driven multi-agent DSH plugin development and real-host acceptance testing",
  "version": "0.1.0",
  "type": "module",

  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },

  "main": "lib/index.js",
  "types": "lib/index.d.ts",

  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },

  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "skills/**/*.md"
  ],

  "license": "MIT",

  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^"
  },

  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-shell": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^"
  },

  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  }
}
