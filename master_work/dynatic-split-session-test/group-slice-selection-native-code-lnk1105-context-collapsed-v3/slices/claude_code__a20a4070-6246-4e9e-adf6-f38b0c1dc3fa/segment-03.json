      "category": "tool_call:PowerShell",
      "role": "assistant",
      "part_type": "tool_use",
      "source_index": 789,
      "source_part_index": 0,
      "tool_name": "PowerShell",
      "arguments": {
        "command": "$req = \"GET /api/status HTTP/1.1`r`nHost: localhost`r`nConnection: close`r`n`r`n\"\n$bytes = [System.Text.Encoding]::ASCII.GetBytes($req)\n$tcp = New-Object System.Net.Sockets.TcpClient(\"localhost\", 7771)\n$stream = $tcp.GetStream()\n$stream.Write($bytes, 0, $bytes.Length)\nStart-Sleep -Milliseconds 500\n$buf = New-Object byte[] 4096\n$n = $stream.Read($buf, 0, 4096)\n[System.Text.Encoding]::ASCII.GetString($buf, 0, $n)\n$tcp.Close()",
        "description": "Raw HTTP test of /api/status"
      }
