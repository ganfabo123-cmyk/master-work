[
  {
    "type": "function",
    "function": {
      "name": "read_trace",
      "description": "Read an exact character page of an allowed input file. Follow next_offset for long content. No hidden content or other arms can be read. Offsets are Unicode characters, not bytes.",
      "parameters": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 48000
          }
        },
        "required": [
          "file_id",
          "offset",
          "max_chars"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_trace",
      "description": "Search visible string values in raw records or slice events. Returns source indices and short matching snippets, never hidden result/thinking payloads. start_match paginates results.",
      "parameters": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "regex": {
            "type": "boolean"
          },
          "start_match": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "file_id",
          "pattern",
          "regex",
          "start_match",
          "limit"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_event",
      "description": "Read a visible event/part by original zero-based source_index and source_part_index. Use offset/next_offset to read long payloads. Does not restore collapsed content.",
      "parameters": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "source_index": {
            "type": "integer",
            "minimum": 0
          },
          "source_part_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 48000
          }
        },
        "required": [
          "file_id",
          "source_index",
          "source_part_index",
          "offset",
          "max_chars"
        ],
        "additionalProperties": false
      }
    }
  },
