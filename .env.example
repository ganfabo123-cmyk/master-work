# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除。
# GraphWeaver 优先读取 DEEPSEEK_*；为兼容已有配置，也支持 PRO_API / PRO_MODEL。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 兼容别名（如果使用这组变量，可不填写上面的 API_KEY / MODEL）
PRO_API=sk-xxxxxxxxxxxxxxxx
PRO_MODEL=deepseek-v4-pro
